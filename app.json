{
  "expo": {
    "name": "Quran Reader",
    "slug": "quran-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#070B14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourorg.quranreader"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070B14"
      },
      "package": "com.yourorg.quranreader"
    },
    "plugins": [
      "expo-font"
    ],
    "assetBundlePatterns": [
      "assets/**/*"
    ]
  }
}
